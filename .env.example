# Copy to .env; all values are application configuration, never model arguments.
SUPPORT_DATABASE_URL=postgresql://support_agent:replace-me@localhost:5432/support
SUPPORT_MODEL_PROVIDER=openai
SUPPORT_MODEL_NAME=your-tool-capable-chat-model
SUPPORT_MODEL_API_KEY=replace-me
# SUPPORT_MODEL_BASE_URL=https://your-compatible-endpoint.example/v1
SUPPORT_MODEL_KWARGS={}
SUPPORT_MODEL_TIMEOUT_SECONDS=60
SUPPORT_MODEL_MAX_TOKENS=2048

SUPPORT_POOL_MIN=1
SUPPORT_POOL_MAX=5
SUPPORT_POOL_TIMEOUT_SECONDS=10
SUPPORT_QUERY_TIMEOUT_MS=5000
SUPPORT_TRANSACTION_TIMEOUT_MS=15000

# OpenAI text-embedding-3-large, 3072 dimensions, for both documents and queries.
# Independent from chat-model credentials; falls back to OPENAI_API_KEY when unset.
SUPPORT_EMBEDDING_API_KEY=replace-me
SUPPORT_EMBEDDING_BASE_URL=https://api.openai.com/v1
SUPPORT_EMBEDDING_TIMEOUT_SECONDS=30
SUPPORT_EMBEDDING_MAX_RETRIES=2
SUPPORT_RETRIEVAL_COUNT=4
SUPPORT_PASSAGE_CHAR_LIMIT=4000
SUPPORT_RESULT_LIMIT=10
SUPPORT_IDENTIFIER_CHAR_LIMIT=2048

SUPPORT_HTTP_TIMEOUT_SECONDS=15
SUPPORT_HTTP_REDIRECT_LIMIT=5
SUPPORT_HTTP_BYTE_LIMIT=262144
SUPPORT_WEB_CHAR_LIMIT=12000

SUPPORT_AGENT_RECURSION_LIMIT=40
SUPPORT_AGENT_MODEL_CALL_LIMIT=8
SUPPORT_AGENT_TOOL_CALL_LIMIT=12
SUPPORT_USER_MESSAGE_CHAR_LIMIT=20000
SUPPORT_SESSION_MESSAGE_LIMIT=200
SUPPORT_EVIDENCE_PATH=./evidence
